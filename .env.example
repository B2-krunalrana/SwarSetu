# SwarSetu Configuration Example
# Copy this to .env and customize as needed

# Server Configuration
SWARSETU_HOST=0.0.0.0
SWARSETU_PORT=8000

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BYTES_PER_SAMPLE=2

# Debug Mode
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration (comma-separated IPs)
CORS_ORIGINS=http://localhost,http://127.0.0.1
